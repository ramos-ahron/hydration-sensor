@startuml HydrationFSM
title Device State Machine (binary RGB LED, no PWM)
skinparam state {
  BackgroundColor White
  BorderColor #444444
}
hide empty description

legend right
  **LED palette (each channel is only ON or OFF: 7 colors + off)**
  |= Color |= Meaning |
  | Red | Low hydration / fault / critical battery |
  | Yellow | Mild hydration / warning |
  | Green | Balanced hydration |
  | Cyan | Over-hydrated |
  | Blue | Bluetooth, always |
  | Magenta | Device is working |
  | White | Device power state (boot, sleep) |

  **Patterns (timer-driven on/off, no dimming)**
  STEADY = on
  SLOW = 1 Hz (500 ms on / 500 ms off)
  FAST = 4 Hz (125 ms on / 125 ms off)
  TRIPLE = three 100 ms flashes, then off
  BEAT = one 100 ms flash, repeated at a stated interval

  **LED priority (highest first, higher preempts lower)**
  1. Faults: INIT_FAULT, SENSOR_ERROR, SHUTDOWN
  2. STORAGE_ERROR
  3. BLE: PAIRING, CONNECTED
  4. Measurement activity: MEASURING, PROCESSING
  5. Hydration result
  6. BATTERY_LOW beat (shows only when LED is otherwise idle)
  SLEEP beat only exists in SLEEP, so it never competes.
endlegend

[*] --> INIT : Power On

state INIT : LED: white STEADY (boot)
state INIT_FAULT : LED: red FAST
state SHUTDOWN : LED: off\nRed FAST for 2 s on button press
state SLEEP_PREP : LED: off
state SLEEP : LED: white BEAT every ~4 s\nPeriodic wake: battery check

INIT --> INIT : watchdog reset
INIT --> INIT_FAULT : Init Fail
INIT_FAULT --> INIT : Button 1: Short Press
INIT --> Active : Init OK

state Active {

  state Measurement {
    state M_IDLE : LED: hydration result for 10 s\nafter an accepted result, then off\nred STEADY = low\nyellow STEADY = mild\ngreen STEADY = balanced\ncyan STEADY = over
    state MEASURING : LED: magenta SLOW
    state PROCESSING : LED: magenta FAST
    state SENSOR_ERROR : LED: red SLOW
    state RESULT_READY : LED: hydration result (as M_IDLE)
    state TRANSMIT : LED: none (keeps result color)
    state STORE_LOCAL : LED: none (keeps result color)
    state STORAGE_ERROR : LED: yellow SLOW

    [*] --> M_IDLE

    M_IDLE --> MEASURING : Mode = Continuous (auto)
    M_IDLE --> MEASURING : Mode = Timer\n[timer trigger]
    M_IDLE --> MEASURING : Mode = Manual\n[Button 1: Short Press]

    MEASURING --> MEASURING : retry [n < MAX_RETRY]
    MEASURING --> PROCESSING : Acquired samples
    MEASURING --> SENSOR_ERROR : Sensor fault /\nread error /\nsensor detached

    PROCESSING --> SENSOR_ERROR : Sensor fault computed
    PROCESSING --> RESULT_READY : Compute done

    SENSOR_ERROR --> M_IDLE : Button 1: Short Press\n(ack / clear fault)

    RESULT_READY --> M_IDLE : reject_flag = true\n(discard measurement)
    RESULT_READY --> TRANSMIT : reject_flag = false\n[BLE.state = CONNECTED]
    RESULT_READY --> STORE_LOCAL : reject_flag = false\n[BLE.state != CONNECTED]

    TRANSMIT --> TRANSMIT : retry [n < MAX_RETRY]
    TRANSMIT --> STORE_LOCAL : done or retries exhausted\n(always store a local copy)

    STORE_LOCAL --> MEASURING : Mode = Continuous
    STORE_LOCAL --> M_IDLE : Mode != Continuous
    STORE_LOCAL --> STORAGE_ERROR : Write error /\nstorage full

    STORAGE_ERROR --> M_IDLE : Button 1: Short Press (ack)
  }

  --

  state BLE {
    state BLE_IDLE : LED: none
    state PAIRING : LED: blue FAST
    state CONNECTED : LED: blue TRIPLE on entry, then none
    state DISCONNECTED : LED: none (transient)

    [*] --> BLE_IDLE

    BLE_IDLE --> PAIRING : Button 1: Long Press\n[M_STATE not in\nProcessing/Measuring/Transmitting]
    PAIRING --> BLE_IDLE : Button 1: Short Press /\ntimeout
    PAIRING --> CONNECTED : Connection complete
    CONNECTED --> BLE_IDLE : Button 1: Long Press\n(force disconnect + re-advertise)\n[M_STATE not in\nProcessing/Measuring/Transmitting]
    CONNECTED --> DISCONNECTED : Link lost /\npeer disconnect request
    DISCONNECTED --> BLE_IDLE : re-advertise
  }

  --

  state "Battery Monitor" as Battery {
    state BATTERY_OK : LED: none
    state BATTERY_LOW : LED: yellow BEAT every 5 s
    state BATTERY_CRITICAL : Trigger shutdown
    state BatteryInit <<choice>>

    [*] --> BatteryInit
    BatteryInit --> BATTERY_OK : Voltage above threshold
    BatteryInit --> BATTERY_LOW : Voltage below threshold

    BATTERY_OK --> BATTERY_LOW : Voltage below threshold
    BATTERY_LOW --> BATTERY_OK : Voltage recovered
    BATTERY_LOW --> BATTERY_CRITICAL : Voltage below\ncritical threshold
    BATTERY_CRITICAL --> BATTERY_LOW : Voltage above\ncritical threshold
  }
}

note right of Active
  Measurement, BLE and Battery Monitor
  run in parallel.
  All short button presses assume BLE != PAIRING.
  Data path: sensor -> watch -> phone
  (sensor transmits to watch, watch sends data to phone).
  Hydration thresholds (low / mild / balanced / over)
  are TBD and must be defined before implementation.
end note

Active --> SLEEP_PREP : M_IDLE for >= 10 s (result display done)\nand electrodes detached\nand Mode != Continuous
Active --> SHUTDOWN : BATTERY_CRITICAL

SLEEP_PREP --> SLEEP : Prep complete
SLEEP --> INIT : Button 1: Short Press
SLEEP --> SHUTDOWN : Periodic battery check = CRITICAL
SHUTDOWN --> INIT : Voltage above\ncritical + margin
@enduml
