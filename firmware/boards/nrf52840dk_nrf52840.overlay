/** For more help, browse the devicetree documentation at https://docs.zephyrproject.org/latest/build/dts/index.html
 *  You can also visit the nRF DeviceTree extension documentation at
 *  https://docs.nordicsemi.com/bundle/nrf-connect-vscode/page/guides/ncs_configure_app.html#devicetree-support-in-the-extension
 */

/ {
    aliases {
        temp0 = &mcp9808;
        ext-btn = &ext_btn;
        red-led = &red_led;
        green-led = &green_led;
        blue-led = &blue_led;

    };

	buttons {
		compatible = "gpio-keys";
		ext_btn: ext_btn {
			gpios = <&gpio1 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		red_led: red_led {
			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
		};
		blue_led: blue_led {
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
		};
		green_led: green_led {
			gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
		};
	};
};

&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    mcp9808: jc42@18 {
        /** Migration to Zephyr v4.0, which is used by NCS v3.2.4 migrates
         *  MCP9808 driver to a generic JEDEC JC-42.4. Source found in
         *  https://docs.zephyrproject.org/latest/build/dts/api/bindings/sensor/jedec%2Cjc-42.4-temp.html
         */
        compatible = "jedec,jc-42.4-temp";
        reg = <0x18>;
        status = "okay";
    };
};
