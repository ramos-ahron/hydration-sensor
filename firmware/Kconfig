mainmenu "Hydration Sensor"

config FSM_ENUM_STRINGS
	bool "Include enum-to-string helpers"
	default y
	help
	  Turns enum to strings

choice FSM_MEASURE_MODE
	prompt "Measurement mode"
	default FSM_MEASURE_MODE_MANUAL
	help
	  Selects the M_IDLE -> MEASURING trigger.

config FSM_MEASURE_MODE_MANUAL
	bool "Manual"
	help
	  Short button press to trigger

config FSM_MEASURE_MODE_TIMER
	bool "Timer"

config FSM_MEASURE_MODE_CONTINUOUS
	bool "Continuous"

endchoice

config MEASURE_INTERVAL_S
	int "Measurement Interval (s)"
	default 60
	range 1 86400
	help
	  Seconds the device waits in the idle measurement state before it starts the next measurement.

config BENCH_ALLOW_USB
	bool "Allow measuring while connected"
	help
	  Lets a measurement start while charger power is present.

config RECORD_SLOTS
	int "Record capacity"
	default 64
	range 4 512

choice RECORD_STORAGE
	prompt "Record storage"
	default RECORD_STORAGE_INTERNAL

config RECORD_STORAGE_INTERNAL
	bool "Internal flash"
	help
	  Settings on NVS in the internal flash.

config RECORD_STORAGE_SD
	bool "SD card"
	select FILE_SYSTEM
	select FAT_FILESYSTEM_ELM
	select DISK_DRIVERS
	imply FS_FATFS_FSTAB_AUTOMOUNT
	help
	  Settings in a file on a FAT SD card. The board overlay must have a disk
	  node with disk-name "SD".

endchoice

choice SETTINGS_BACKEND
	default SETTINGS_FILE if RECORD_STORAGE_SD
endchoice

config SETTINGS_FILE_PATH
	default "/SD:/hs/settings" if RECORD_STORAGE_SD

source "Kconfig.zephyr"
